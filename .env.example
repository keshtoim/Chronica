# Скопируй в .env (не коммитится) и заполни реальными значениями.

# Client Secret для Desktop-типа OAuth-клиента в Google Cloud Console (раздел "Clients").
# Не по-настоящему секретен для installed-приложений, но Google всё равно требует его
# в обмене authorization code на токены и блокирует пуш в открытый репозиторий.
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
